# TabiAI / Tabitoken API Configuration
TABI_API_KEY=your_tabi_api_key_here
TABI_BASE_URL=https://api.tabitoken.com/v1
TABI_MODEL=claude-opus-5

# Chrome DevTools Protocol Configuration
CDP_URL=http://localhost:9222

# Asset Harvester Timing (Seconds)
# Default production: Initial wait 1200s (20m), poll 120s (2m), max 4500s (75m)
HARVESTER_INITIAL_WAIT_SEC=1200
HARVESTER_POLL_INTERVAL_SEC=120
HARVESTER_TIMEOUT_SEC=4500

# Audio & Voice Settings
TARGET_VOICE_NAME=en-US-ChristopherNeural
SEED_VC_CLI_PATH=
RVC_CLI_PATH=

# YouTube Publishing Settings
YOUTUBE_CLIENT_SECRETS=config/client_secrets.json
YOUTUBE_PRIVACY_STATUS=private
